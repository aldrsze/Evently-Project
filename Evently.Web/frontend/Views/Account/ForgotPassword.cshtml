@{
    ViewData["Title"] = "Reset password";
}
<main class="auth-page auth-single" data-page="forgot-password">
    <section class="auth-art-panel"><a class="brand brand-inverse" href="/"><span class="brand-mark"><svg
        viewBox="0 0 32 32" fill="none">
        <path d="M6 8.5h20v4.1a3.4 3.4 0 0 0 0 6.8v4.1H6v-4.1a3.4 3.4 0 0 0 0-6.8V8.5Z"
              fill="currentColor" />
    </svg></span><span class="brand-word">evently<span class="brand-dot">.</span></span></a>
    <div class="auth-art-copy"><span class="section-kicker">NO WORRIES</span>
        <h2>Let’s get you<br />back to <em>the good stuff.</em></h2>
        <p>This screen gives demo feedback only. No email is sent.</p>
    </div>
</section>
<section class="auth-form-panel">
    <div class="auth-form-wrap"><a class="back-link" href="/Account/Login"><i data-lucide="arrow-left"></i> Back to
        log in</a><span class="section-kicker">A QUICK RESET</span>
        <h1>Forgot your <span>password?</span></h1>
        <p class="auth-subtitle">Enter the demo email address and we’ll show a simulated confirmation.</p>
        <form class="auth-form" data-forgot-form novalidate><label class="form-field"><span>Email address
            <b>*</b></span><input name="email" type="email" autocomplete="email"
                                  placeholder="you@example.com" required /><small class="field-error"></small></label><button
            class="button button-primary button-full button-large" type="submit">Show demo confirmation <i
            data-lucide="arrow-right"></i></button>
            <p class="auth-demo-note"><i data-lucide="info"></i> This frontend-only demo does not send emails or
                change passwords.</p>
            </form>
        </div>
    </section>
</main>